// crossingvalleys.com: a Worker with static assets. `npm run build` writes the static site to dist/; `wrangler deploy`
// uploads it with this file as the only config (no framework adapter). worker/index.js runs first for every request
// (old WordPress URLs, /feed/, staging noindex), then hands over to the assets.
// Production has no route yet: crossingvalleys.com is still WordPress at OVH until Basile moves the domain (AGENTS.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crossingvalleys",
  "compatibility_date": "2026-10-26",
  "workers_dev": false,
  "preview_urls": false,
  "main": "./worker/index.js",
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Staging: `wrangler deploy --env staging` publishes the same build at cv.basilev.com, an unlisted hostname
  // (repos.yaml `unlisted:`): every response noindex, robots.txt Disallow.
  "env": {
    "staging": {
      "name": "crossingvalleys-staging",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "STAGING": "1" },
      "routes": [{ "pattern": "cv.basilev.com", "custom_domain": true }],
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": true,
        "directory": "./dist",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "404-page"
      }
    }
  }
}
